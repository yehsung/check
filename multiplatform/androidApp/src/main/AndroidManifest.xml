<?xml version="1.0" encoding="utf-8"?>
<!--
  아잉체크 Android 매니페스트(W1-g 셸 — W1 병합 뒤로는 조정자 몫, K11·§8-3).
  병합 매니페스트를 시험이 직접 읽어 단언한다(androidApp …/app/MergedManifestTest):
  - 권한 허용 목록(E§9.8): INTERNET · ACCESS_NETWORK_STATE · POST_NOTIFICATIONS · VIBRATE · WAKE_LOCK(FCM) · c2dm RECEIVE(FCM)
    · RECEIVE_BOOT_COMPLETED(WorkManager) · DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION(androidx.core 서명 권한). AD_ID 없음.
    FOREGROUND_SERVICE 는 WorkManager 가 끌어오지만 이 앱은 포그라운드 서비스를 쓰지 않아(E§4.2) 지운다.
  - 백업: allowBackup=false + fullBackupContent=false(Android 11 이하 Auto Backup) + 설치 UUID·금고는 noBackupFilesDir
    (플랫폼이 언제나 건너뛰는 자리, E§5.2). Android 12+ 클라우드 백업·기기 이전은 데이터 추출 규칙 파일
    (res/xml/data_extraction_rules.xml — 모든 도메인 제외)과 noBackupFilesDir 가 보증한다.
    fullBackupContent 가 Android 12+ 기기 이전까지 끈다고는 기대지 않는다(실측하지 않았다).
  - 평문 통신 0(usesCleartextTraffic=false — debug 도 같다. localhost 예외를 두지 않는다).
  - MainActivity launchMode=singleTask(E-U16: 딥링크 → 프로세스 죽음 → 런처 아이콘 뒤 Activity 1개).
  - MainActivity configChanges(Compose 앱 관례 전부): 구성 변경으로 Activity 를 다시 만들지 않는다. 다시 만들면 화면 수명이 끊겨(rummyScreenDidDisappear · closeScreen) 방향 답이 세로로 뒤집히고, 끝난 판의 결과가 접히고,
    미니게임 판이 끝나고, 화면 꺼짐 방지가 죽은 창에 남는다. 회전뿐 아니라 다크 모드 · 글꼴 크기 · 화면 크기(density) · 언어 · 키보드 연결도 같다.
    화면이 전부 Compose 라 직접 받아도 그대로 다시 잰다: 색은 isSystemInDarkTheme(LocalConfiguration) → AingTheme, 시스템 막대는 MainActivity 의 barStyle(시험 SystemBarIconsConfigChangeTest), 글자는 LocalDensity(시험 ActivityConfigChangeTest).
    창 바탕은 XML 테마(라이트 고정 · 다크 값 없음)라 원래 구성을 안 따르고, 그 위를 Compose Surface 가 덮는다. 방향 값 소유자는 RummyOrientationDriver.
  - Firebase 자동 초기화 0: FirebaseInitProvider 를 지우고, 메시징 자동 토큰도 끈다(release 조립 지점만 손으로 초기화 — E§6.6).
  - 앱 공개 범위(queries): PROCESS_TEXT(text/plain) 하나만 연다 — 판 7 말풍선 고르기 메뉴의 [번역]은 Compose 가 앱 안에서 번역 앱을 묻는
    길(queryIntentActivities)로만 오고, targetSdk 30+ 는 이 선언 없이는 그 결과에서 번역 앱을 지운다(검토 F1). QUERY_ALL_PACKAGES 는 쓰지 않는다.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <!-- 판 7 말풍선 고르기 [번역](PROCESS_TEXT 앱 — MergedManifestTest.processTextAppsAreVisibleToTheSelectionMenu). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:name=".app.AingApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="아잉체크"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        tools:targetApi="36">

        <activity
            android:name=".shell.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale|fontWeightAdjustment|locale|layoutDirection|keyboard|keyboardHidden|navigation|touchscreen|mcc|mnc|colorMode"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="aingcheck" />
            </intent-filter>
        </activity>

        <service
            android:name=".push.AingMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>


        <!-- 위젯 4종(W3-b 조정자 패치 0001 · E§7.1). 수신자 클래스 이름은 홈 화면이 기억하는 이름이다(iOS kind 자리 — AingWidgetKind 표가 고정한다).
             시스템 APPWIDGET_UPDATE 를 받아야 해서 exported=true 다(앱 위젯 공급자는 언제나 그렇다). -->
        <receiver
            android:name=".widget.WorkingNowWidgetReceiver"
            android:exported="true"
            android:label="@string/aing_widget_working_now_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/aing_widget_working_now" />
        </receiver>
        <receiver
            android:name=".widget.MyTodayWidgetReceiver"
            android:exported="true"
            android:label="@string/aing_widget_my_today_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/aing_widget_my_today" />
        </receiver>
        <receiver
            android:name=".widget.TodosWidgetReceiver"
            android:exported="true"
            android:label="@string/aing_widget_todos_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/aing_widget_todos" />
        </receiver>
        <receiver
            android:name=".widget.AILimitsWidgetReceiver"
            android:exported="true"
            android:label="@string/aing_widget_ai_limits_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/aing_widget_ai_limits" />
        </receiver>

        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_aing" />

        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />
    </application>
</manifest>
